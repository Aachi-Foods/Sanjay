# Supabase project settings (Project Settings > API)
# The site is a static export with no server, so this anon key is the only
# credential used — everywhere it's used, Row Level Security policies on the
# `inquiries` table (see README) decide what it's actually allowed to do.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
