# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by the server-side /api/contact route to write inquiries.
# Service role key bypasses Row Level Security — never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard credentials (MVP hardcoded auth — replace with real auth before scaling)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bnr2024
